RewriteEngine On
RewriteRule ^(?:vendor|logs|dao|services|routes|config|middleware)(?:/|$) - [F,NC]
<FilesMatch "^(?:\.env(?:\..*)?|database\.sql|test_dao\.php|bootstrap\.php|composer\.(?:json|lock))$">
  Require all denied
</FilesMatch>
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]